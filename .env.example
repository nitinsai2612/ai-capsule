# AI Capsule - environment variables
# Copy to .env for local development. NEVER commit a real .env file.
# On Render these are set in Dashboard > Service > Environment.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Public base URL of this application.
# Local:  http://localhost:3001
# Render: https://<your-service-name>.onrender.com
APP_BASE_URL=http://localhost:3001

# --- GitHub OAuth ----------------------------------------------------------
# From GitHub > Settings > Developer settings > OAuth Apps > your app.
# Authorization callback URL registered there must be:
#   <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Application JWT -------------------------------------------------------
# Secret used to sign the application JWT that Express issues after OAuth.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional, defaults to 2h
JWT_EXPIRES_IN=2h

# --- Storage ---------------------------------------------------------------
# SQLite database file path. Defaults to ./data/aicapsule.db
DATABASE_FILE=./data/aicapsule.db
